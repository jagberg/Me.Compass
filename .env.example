# Me.Compass configuration — copy to .env and fill in. The backend loads this root .env at startup
# (src/load-env.ts); docker-compose also reads it for variable substitution. Never commit .env.

# --- Server ---
PORT=3000
# DATA_DIR is optional; defaults to backend/data. Docker sets it to /data.
# DATA_DIR=./data

# --- Identity (who "the reader" is, for action extraction) ---
ME_NAME=Justin Goldberg
ME_EMAIL=you@example.com

# --- Google OAuth app (for Gmail / Drive / Chat) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Leave/HR deep link (play button on a leave action) ---
ESS_URL=https://ess.cloud.micropay.com.au/#/

# --- JIRA (approval reconciliation). Leave blank to disable; all four required to enable. ---
JIRA_BASE_URL=https://compareclub.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_ACCOUNT_ID=
